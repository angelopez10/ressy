# ---------------------------------------------------------------------------
# Ressy — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` está en
# .gitignore y nunca debe commitearse.
#
# Solo las `NEXT_PUBLIC_*` llegan al browser (CLAUDE.md §9). Todo lo demás es
# secreto de servidor.
# ---------------------------------------------------------------------------

# --- Supabase (requerido) --------------------------------------------------
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# `sb_publishable_...`. Viaja al browser por diseño: la protege RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# `sb_secret_...`. Bypassa RLS por completo. Solo servidor: webhooks y jobs.
# Jamás en el cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=


# ===========================================================================
# Todo lo de abajo está comentado a propósito: son integraciones de sesiones
# futuras. Descoméntalas cuando se implementen.
# ===========================================================================

# --- Stripe: suscripciones (Billing) + cobros de negocios (Connect) --------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_CONNECT_CLIENT_ID=

# --- Mercado Pago: anticipos (Chile/CLP, cuenta del negocio vía OAuth) ------
# Credenciales de la APLICACIÓN de Ressy en MP (no de un vendedor). Sandbox en dev.
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# Secret de la app para validar la firma x-signature de los webhooks.
# MP_WEBHOOK_SECRET=
# Clave AES-256 (32 bytes en base64 o hex) para cifrar los tokens OAuth de los
# vendedores en reposo. Genera una con: openssl rand -base64 32
# RESSY_MP_TOKEN_KEY=
# Dev/sandbox: paga en sandbox.mercadopago.cl (usuarios de prueba reportan
# live_mode=true, así que se decide con esta env). En producción: NO setear.
# MP_SANDBOX=true

# --- Mercado Pago: suscripciones del plan (Chile/CLP, cuenta de RESSY) ------
# Access token de la CUENTA DE RESSY para el preapproval del plan (el negocio le
# paga a Ressy su suscripción). Distinto del OAuth de vendedores de arriba: acá
# la plata SÍ va a Ressy (es el ingreso SaaS). Secreto de servidor.
# MP_ACCESS_TOKEN=
# La firma de estos webhooks se valida con el mismo MP_WEBHOOK_SECRET (misma app).
# Solo DEV/sandbox: fuerza el email del pagador a un COMPRADOR de prueba (MP exige
# que collector y payer sean ambos de prueba). En prod se ignora. Usa el email de
# una "Cuenta de prueba" comprador, distinta de la cuenta dueña de la app.
# MP_TEST_PAYER_EMAIL=

# --- Resend: emails transaccionales ---------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# --- Twilio: recordatorios por WhatsApp/SMS (solo planes pagos) ------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# --- Inngest: jobs y cron (recordatorios T-24h / T-2h) ---------------------
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- PostHog: analytics de producto (lib/analytics) -----------------------
# UN PROYECTO POR AMBIENTE (dev/prod separados, igual que Supabase): la MISMA
# variable con un VALOR distinto en cada ambiente de Vercel. En local, dejar sin
# key ⇒ `track`/`trackServer` hacen no-op con console.debug (no ensucian ningún
# proyecto). La key pública sirve para client Y server (mismo project API key).
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Opcionales: solo si el server debe usar otro proyecto/host que el cliente.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# --- App ------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Super Admin: panel interno de Ressy (app/(superadmin)) ---------------
# Panel de la torre de control. SOLO para el equipo de Ressy.
#
# RESSY_ADMIN_SECRET es obligatoria para que el panel exista: firma las cookies
# de sesión elevada e impersonación, y es el pepper de los códigos OTP. Sin
# ella el panel devuelve 404 para todo el mundo (failsafe deliberado).
# Generar con:  openssl rand -base64 48
# RESSY_ADMIN_SECRET=
#
# Segundo factor de AUTORIZACIÓN (opcional en dev, SETEARLA en prod): lista de
# emails separados por coma. Con esto puesto hay que estar en la tabla
# `ressy_admins` Y en esta lista, así una escritura maliciosa en la DB por sí
# sola no otorga acceso.
# RESSY_ADMIN_EMAILS=vos@getressy.com,socio@getressy.com
#
# Tipo de cambio solo para la cifra de MRR total en USD del panel. Ressy NO
# convierte monedas (CLAUDE.md §3): es una referencia interna, siempre mostrada
# como aproximada. Default: 0.00104.
# RESSY_USD_PER_CLP=0.00104
